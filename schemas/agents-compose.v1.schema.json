{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devel-solid.github.io/agents/schemas/agents-compose.v1.schema.json",
  "title": "Manifesto de composição agents, versão 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["agents", "outputs"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": { "$ref": "#/definitions/nonempty" },
        "ref": { "$ref": "#/definitions/nonempty" }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AGENTS.md"],
      "properties": {
        "AGENTS.md": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include"],
          "properties": {
            "include": {
              "type": "object",
              "additionalProperties": false,
              "required": ["conventions"],
              "properties": {
                "conventions": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["out_dir", "local", "remote", "entries"],
                  "properties": {
                    "out_dir": { "$ref": "#/definitions/nonempty" },
                    "local": { "$ref": "#/definitions/sourceRoot" },
                    "remote": { "$ref": "#/definitions/sourceRoot" },
                    "entries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["origin", "from"],
                        "properties": {
                          "origin": { "enum": ["local", "remote"] },
                          "from": { "$ref": "#/definitions/nonempty" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "nonempty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sourceRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tpl_dir"],
      "properties": { "tpl_dir": { "$ref": "#/definitions/nonempty" } }
    }
  }
}
