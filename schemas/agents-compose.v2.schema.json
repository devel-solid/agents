{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devel-solid.github.io/agents/schemas/agents-compose.v2.schema.json",
  "title": "Manifesto de composição agents, versão 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outputs"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": {
          "$ref": "#/definitions/nonempty"
        },
        "ref": {
          "$ref": "#/definitions/nonempty"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AGENTS.md"],
      "properties": {
        "AGENTS.md": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include"],
          "properties": {
            "include": {
              "type": "object",
              "additionalProperties": false,
              "required": ["conventions"],
              "properties": {
                "conventions": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["out_dir", "local", "remote", "entries"],
                  "properties": {
                    "out_dir": {
                      "$ref": "#/definitions/nonempty"
                    },
                    "local": {
                      "$ref": "#/definitions/sourceRoot"
                    },
                    "remote": {
                      "$ref": "#/definitions/sourceRoot"
                    },
                    "entries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["origin", "from"],
                        "properties": {
                          "origin": {
                            "const": "remote"
                          },
                          "from": {
                            "$ref": "#/definitions/nonempty"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sourceRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tpl_dir"],
      "properties": {
        "tpl_dir": {
          "$ref": "#/definitions/nonempty"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outputs": {
            "properties": {
              "AGENTS.md": {
                "properties": {
                  "include": {
                    "properties": {
                      "conventions": {
                        "properties": {
                          "entries": {
                            "minItems": 1,
                            "type": "array"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "type": "object",
        "required": ["agents"],
        "properties": {
          "agents": {
            "$ref": "#/properties/agents"
          }
        }
      }
    }
  ]
}
