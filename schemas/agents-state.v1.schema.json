{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rendererContract",
    "normalization",
    "generation",
    "inputs",
    "outputs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rendererContract": { "const": 1 },
    "normalization": { "const": "utf8-lf" },
    "generation": { "$ref": "#/definitions/hash" },
    "inputs": { "type": "array", "items": { "$ref": "#/definitions/source" } },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "sources"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/definitions/hash" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/source" }
          }
        }
      }
    }
  },
  "definitions": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "origin", "sha256"],
      "allOf": [
        {
          "if": {
            "properties": { "origin": { "const": "remote" } },
            "required": ["origin"]
          },
          "then": {
            "properties": { "repository": {}, "commit": {} },
            "required": ["repository", "commit"]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "properties": { "repository": {} },
                  "required": ["repository"]
                },
                { "properties": { "commit": {} }, "required": ["commit"] }
              ]
            }
          }
        }
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["local", "remote", "manifest"] },
        "sha256": { "$ref": "#/definitions/hash" },
        "family": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }
      }
    }
  }
}
