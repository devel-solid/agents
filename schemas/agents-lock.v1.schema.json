{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devel-solid.github.io/agents/agents-lock.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rendererContract",
    "normalization",
    "engineVersion",
    "repository",
    "requestedRef",
    "commit",
    "remote",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rendererContract": { "type": "integer", "minimum": 1 },
    "normalization": { "const": "utf8-lf" },
    "engineVersion": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "requestedRef": { "type": "string", "minLength": 1 },
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tplDir", "entries"],
      "properties": {
        "tplDir": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
